# Адрес API бэкенда. Ходит по нему только сервер витрины, браузер обращается к своему /api
PUBLIC_API_URL=http://localhost:3380/api

# Публичный адрес витрины без слэша на конце: canonical, sitemap.xml, robots.txt, Open Graph.
# В разработке можно не задавать, в продакшене обязателен
# PUBLIC_SITE_URL=https://shop.example.ru

# Переменные adapter-node для запуска сборки, подробнее в README, раздел «Вход и сессия».
# node build сам .env не читает: node --env-file=.env build или переменные окружения процесса
# ORIGIN=https://shop.example.ru
# BODY_SIZE_LIMIT=12M
